{
  "name": "bayblaze-api",
  "version": "0.1.0",
  "private": true,
  "description": "BayBlaze shared backend API for apps, routing, tracking, inventory, driver workflow, and service orchestration.",
  "main": "dist/server.js",
  "scripts": {
    "api:dev": "tsx watch src/server.ts",
    "api:build": "tsc -p tsconfig.json",
    "api:start": "node dist/server.js",
    "api:typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "build:all": "npm run api:build && npm run medusa:build",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "medusa:install": "npm install --prefix medusa",
    "medusa:dev": "npm run backend:dev --prefix medusa",
    "medusa:build": "npm run build -w @dtc/backend --prefix medusa",
    "medusa:start": "npm run start -w @dtc/backend --prefix medusa",
    "medusa:migrate": "npm run backend:docker:migrate --prefix medusa",
    "medusa:docker:up": "npm run backend:docker:up --prefix medusa",
    "medusa:docker:logs": "npm run backend:docker:logs --prefix medusa",
    "medusa:seed:bayblaze": "npm run backend:seed:bayblaze --prefix medusa"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^14.0.0",
    "helmet": "^8.0.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "resend": "^6.12.4",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
