NODE_ENV=development
PORT=3040

# Comma-separated app origins allowed to call bayblaze-api.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Shared API auth/tokening
BAYBLAZE_API_SERVICE_TOKEN=replace-me
BAYBLAZE_MEDUSA_SERVICE_TOKEN=replace-me
ACCOUNT_SESSION_SECRET=
ACCOUNT_SESSION_TTL_SECONDS=1209600
DRIVER_SESSION_SECRET=
DRIVER_SESSION_TTL_SECONDS=1209600

# Integrated Medusa service
MEDUSA_BACKEND_URL=http://medusa:9000
BAYBLAZE_DRIVER_SERVICE_TOKEN=
BAYBLAZE_INVENTORY_SERVICE_TOKEN=
MEDUSA_ADMIN_API_TOKEN=
MEDUSA_DRIVER_QUEUE_PATH=/admin/bayblaze/driver-queues/{uid}
MEDUSA_DELIVERY_ATTEMPT_PATH=/admin/bayblaze/delivery-attempts
MEDUSA_REPRINT_LABELS_PATH=/admin/bayblaze/orders/{orderId}/reprint-labels
MEDUSA_ADMIN_ORDERS_PATH=/admin/bayblaze/orders
MEDUSA_CUSTOMER_SESSION_PATH=/admin/bayblaze/customer-sessions
DATABASE_URL=postgres://medusa:replace-me@postgres:5432/medusa?sslmode=disable
POSTGRES_DB=medusa
POSTGRES_USER=medusa
POSTGRES_PASSWORD=replace-me
REDIS_URL=redis://redis:6379
JWT_SECRET=
COOKIE_SECRET=
MEDUSA_ADMIN_ONBOARDING_TYPE=default
STORE_CORS=https://bayblaze.net
ADMIN_CORS=https://api.bayblaze.net
AUTH_CORS=https://bayblaze.net,https://api.bayblaze.net
LABEL_PRINTER_AGENT_URL=http://100.76.159.4:4786
LABEL_PRINTER_AGENT_TOKEN=
BAYBLAZE_STOREFRONT_URL=https://bayblaze.net
NFC_STOREFRONT_URL=https://nfc.bayblaze.net
NFC_STRIPE_SECRET_KEY=
NFC_STRIPE_WEBHOOK_SECRET=
NFC_USPS_STANDARD_FEE_CENTS=599
NFC_LOCAL_DELIVERY_FEE_CENTS=0
# Temporary fallback tax rate in basis points until Stripe Tax registration is wired for NFC products.
NFC_TAX_RATE_BPS=0
# Server-only private delivery origin. Do not expose in frontend env or logs.
NFC_LOCAL_DELIVERY_ORIGIN_ADDRESS=
BAYBLAZE_INVENTORY_IMAGE_UPLOAD_DIR=/app/uploads/bayblaze-inventory

# Referral partner rules. Keep both secrets server-only and rotate them only
# with a planned attribution/customer-reference migration.
PARTNER_ATTRIBUTION_WINDOW_DAYS=30
PARTNER_COMMISSION_ELIGIBILITY_DAYS=7
PARTNER_REFERRAL_CODE_PREFIX=LOCAL
PARTNER_SELF_ENROLLMENT_DISCOUNT_PERCENT=20
PARTNER_SELF_ENROLLMENT_COMMISSION_PERCENT=30
PARTNER_SELF_ENROLLMENT_MINIMUM_SPEND_CENTS=0
PARTNER_SELF_ENROLLMENT_SINGLE_USE_PER_ACCOUNT=false
PARTNER_TERMS_VERSION=2026-07-23
PARTNER_ATTRIBUTION_TOKEN_SECRET=
PARTNER_CUSTOMER_HASH_SECRET=

# Internal routing/tracking modules use Google Maps server-side from bayblaze-api.
GOOGLE_MAPS_API_KEY=

# Universal Google OAuth. Redirect URL may be a comma-separated allowlist for
# storefront/admin/driver/inventory callback URLs.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=https://bayblaze.net/api/auth/oauth/google/callback,https://admin.bayblaze.net/auth/google/callback,https://driver.bayblaze.net/auth/google/callback,https://inventory.bayblaze.net/auth/google/callback

# Unified Firebase backend state. Driver and routing/cache collections live
# in the bayblaze-isochronos project behind bayblaze-api.
FIREBASE_PROJECT_ID=bayblaze-isochronos
FIRESTORE_DATABASE_ID=(default)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
FIREBASE_STORAGE_BUCKET=bayblaze-isochronos.firebasestorage.app
FIREBASE_WEB_API_KEY=

# Driver auth/email flows
RESEND_API_KEY=
DRIVER_EMAIL_FROM=
DRIVER_EMAIL_REPLY_TO=
DRIVER_SIGNUP_CODE_TTL_MINUTES=15
DRIVER_WEB_PUSH_PUBLIC_KEY=
DRIVER_WEB_PUSH_PRIVATE_KEY=
DRIVER_WEB_PUSH_SUBJECT=mailto:drivers@bayblaze.net

# Deprecated split-project variables; do not use for new code.
DRIVER_FIREBASE_PROJECT_ID=
DRIVER_FIRESTORE_DATABASE_ID=
DRIVER_FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Storage; start simple, migrate to R2/S3 later
BAYBLAZE_STORAGE_MODE=local
BAYBLAZE_UPLOAD_DIR=/app/uploads
BAYBLAZE_PUBLIC_API_URL=http://localhost:3040
